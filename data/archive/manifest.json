  "note": "the validation key is the suite's own verdict, kept beside the hashes so a deposit carries both",
  "validation": {
    "checks": [
      {
        "check": "the eight operators are pairwise disjoint",
        "file": "09_validation/signature_collisions.csv",
        "found": 0,
        "held": true,
        "must_be": "empty",
        "statement": "no definition signature appears under two operators, tested over every definition on every starting ion"
      },
      {
        "check": "every ring in a product traces to its source",
        "file": "09_validation/perception_check.csv",
        "found": 0,
        "held": true,
        "must_be": "no disagreeing row",
        "statement": "each ring is a ring of the parent or of the fragment the edit introduced, unchanged in size and bond orders"
      },
      {
        "check": "no atom's aromatic flag changed",
        "file": "09_validation/perception_aromaticity.csv",
        "found": 0,
        "held": true,
        "must_be": "empty",
        "statement": "an atom's aromatic flag matches the flag its source carried; only disagreements are written to the file"
      },
      {
        "check": "certification refused nothing",
        "file": "05_single_edits/refusal_records.csv",
        "found": 0,
        "held": true,
        "must_be": "empty",
        "statement": "certification is an assertion that the construction rules held, so a refusal is a defect and not a result"
      },
      {
        "check": "the label route and the search route agree",
        "file": "05_single_edits/examination_records.csv",
        "found": 0,
        "held": true,
        "must_be": "no disagreeing row",
        "statement": "certification reads the label applied before the edit and the judge searches the product for the core; they answer the same question by different routes"
      },
      {
        "check": "no product is identical to its parent",
        "file": "05_single_edits/examination_records.csv",
        "found": 0,
        "held": true,
        "must_be": "empty",
        "statement": "Swap's incoming component and Cross-over's joined fragment must differ from what left, which is a precondition and not a filter"
      },
      {
        "check": "every body component attaches at exactly one point",
        "file": "04_fragments/component_instances.csv",
        "found": 0,
        "held": true,
        "must_be": "every row's attachment_count is 1",
        "statement": "a consequence of cutting the body only at acyclic bonds, since the fixed set is connected"
      },
      {
        "check": "every body component was admitted to the library",
        "file": "04_fragments/component_instances.csv",
        "found": 0,
        "held": true,
        "must_be": "every row admitted",
        "statement": "a component is excluded by being part of a ring the core covers in part, which is decided from the parent graph, and never by failing to sanitize"
      },
      {
        "check": "the negative test: the unchanged starting ion",
        "file": "09_validation/negative_tests.csv",
        "found": "certified",
        "held": true,
        "must_be": "certified",
        "statement": "the starting ion must certify, or every refusal below would be meaningless"
      },
      {
        "check": "the negative test: a bond added between two core atoms",
        "file": "09_validation/negative_tests.csv",
        "found": "refused by 4_the_induced_bond_set_on_those_atoms_unchanged",
        "held": true,
        "must_be": "refused",
        "statement": "requirement 4 holds the complete induced bond set, so a bond added inside the core is a bond the core did not have"
      },
      {
        "check": "the negative test: a core bond removed",
        "file": "09_validation/negative_tests.csv",
        "found": "refused by 1_one_connected_closed_shell_molecule_that_sanitizes",
        "held": true,
        "must_be": "refused",
        "statement": "requirement 4 again, from the other side"
      },
      {
        "check": "the negative test: a core atom altered",
        "file": "09_validation/negative_tests.csv",
        "found": "refused by 3_every_core_atom_present_as_it_was",
        "held": true,
        "must_be": "refused",
        "statement": "requirement 3 holds every core atom's element, charge and aromaticity"
      }
    ],
    "definition_space_rows": 11192,
    "every_check_held": true,
    "library_components": 255,
    "note": "a product reached twice by different routes is counted and not refused; it is the honest measure of how much each operator adds, and it is not a collision of definition",
    "products_reached_by_two_operators_from_one_parent": 18005
  }
